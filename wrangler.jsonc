{
  // Serveur AlertesPro (Cloudflare Worker + base D1)
  "name": "omk81",
  "main": "mt5-alertes/serveur/worker.js",
  "compatibility_date": "2025-07-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alertespro"
    }
  ],
  // chaque minute : robot dans le cloud (signaux sans PC)
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
